# Copy this file to config/allowlist.txt and edit the local copy.
#
# Domains that Artex may reach through Leash.
# One entry per line. Blank lines and lines starting with # are ignored.
#   - bare host      : any TCP port, exact hostname only (no subdomains)
#   - host:port      : only that TCP port
#   - *.host         : explicit wildcard, HTTP(S) only, proxy-enforced
#   - no scheme, path, credentials, trailing dot, or bare "*"
#
# Replace these examples with your own domains. The LLM endpoint
# Artex uses must also be listed, or Artex cannot call the model.
example.com
www.example.com
api.example.com

# Examples (uncomment deliberately):
# app.example.com:443
# *.example.com
