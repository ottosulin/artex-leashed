# Copy to .env. scripts/run.sh generates this file and a random password
# automatically if .env is missing.

# Required by the embedded PostgreSQL. Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Drop CAP_NET_RAW from the governed container. This closes the raw-socket
# bypass around Leash's connect policy. Set to 0 only if a tool truly needs raw
# sockets (for example nmap SYN scans); connect scans (`nmap -sT`) still work.
DROP_NET_RAW=1

# Optional LLM credentials. Add the LLM endpoint host to config/allowlist.txt
# as well; otherwise Leash denies the request.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Leash manager image and Control UI bind address.
LEASH_IMAGE=public.ecr.aws/s5i7k8t3/strongdm/leash:latest
LEASH_LISTEN=127.0.0.1:18080
